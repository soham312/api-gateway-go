{
  "server": {
    "port": 8080,
    "read_timeout": "10s",
    "write_timeout": "10s",
    "tls": {
      "enabled": false
    }
  },
  "middleware": {
    "cors": {
      "allowed_origins": ["*"]
    },
    "jwt": {
      "secret": "testsecret"
    },
    "rate_limit": {
      "requests_per_second": 2,
      "burst": 5,
      "cleanup_interval": "1m",
      "ttl": "5m"
    }
  },
  "routes": []
}
